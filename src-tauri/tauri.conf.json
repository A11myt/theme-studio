{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Theme Studio",
  "version": "0.4.0",
  "identifier": "de.a11myt.themestudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Theme Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Color themes from your own wallpapers",
    "category": "GraphicsAndDesign"
  },
  "mainBinaryName": "theme-studio",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3ODcxODBGN0VCMTQ0MEMKUldRTVJMRitEeGlIQjZqQWNkNVB2NDFjYVc3NEFDT3JyeE5HQVZYdGVGQ3FSSEpEVGp5MkgwYXYK",
      "endpoints": [
        "https://github.com/A11myt/theme-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
