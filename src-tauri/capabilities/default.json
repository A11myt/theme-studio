{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte der App: wallhaven, Speichern-Dialog, Dateien schreiben, Zwischenablage",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://wallhaven.cc/api/v1/*"
        },
        {
          "url": "https://w.wallhaven.cc/full/*"
        }
      ]
    },
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    "clipboard-manager:allow-write-text"
  ]
}
