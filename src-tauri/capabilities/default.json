{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte der App: wallhaven-Suche, Dialoge (Speichern, Ordner w\u00e4hlen), Zwischenablage \u2013 Dateien schreibt die App selbst (Rust)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://wallhaven.cc/api/v1/*"
        }
      ]
    },
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:allow-restart"
  ]
}
